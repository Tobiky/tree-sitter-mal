================
DynaMAL ADD (A>)
================

category Test {
  asset A 
  {
    | step A> self/children[B]
  }
  asset B {}
  asset C {}
}
associations {
  A [children] * <-- rel --> * [parent] B
  A [siblings] * <-- sib --> * [siblings] C
}

